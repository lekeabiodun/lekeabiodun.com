---
import { excerpt, formatDate, type PostSummary } from '../lib/sanity';

interface Props {
    posts: PostSummary[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p class="mt-8 text-base leading-relaxed text-gray-500">No posts published yet.</p>}

{
    posts.map((post) => (
        <article class="mt-8">
            <p class="text-sm text-gray-500">{formatDate(post.publishedAt || post._createdAt)}</p>
            <div class="prose prose-zinc max-w-none dark:prose-invert sm:prose-lg">
                <h2 class="mt-3 text-lg font-medium text-gray-800 dark:text-gray-200">
                    <a class="hover:underline focus:underline" href={`/blog/${post.slug}`}>
                        {post.title}
                    </a>
                </h2>
                <p class="mt-3 text-base leading-relaxed text-gray-500">{excerpt(post.excerpt)}</p>
                <p class="mt-3 text-base text-gray-700 dark:text-gray-300">
                    <a class="hover:underline focus:underline" href={`/blog/${post.slug}`}>
                        Read article &rarr;
                    </a>
                </p>
            </div>
        </article>
    ))
}
