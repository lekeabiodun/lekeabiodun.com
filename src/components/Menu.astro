---
// §1.7: /uses is demoted from the top nav to the footer.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
    { href: '/', label: 'Home', active: path === '/' },
    { href: '/about', label: 'About', active: path === '/about' },
    { href: '/work-with-me', label: 'Work with me', active: path === '/work-with-me' },
    { href: '/blog', label: 'Blog', active: path === '/blog' || path.startsWith('/blog/') },
];

const activeClass =
    'text-gray-900 dark:text-gray-100 underline underline-offset-4 decoration-gray-400 dark:decoration-gray-600';
const inactiveClass = 'text-gray-500 border-transparent';
---

{
    links.map((link) => (
        <li>
            <a
                class:list={[
                    link.active ? activeClass : inactiveClass,
                    'whitespace-nowrap py-1 font-medium hover:text-gray-900 dark:hover:text-gray-100',
                ]}
                href={link.href}
            >
                {link.label}
            </a>
        </li>
    ))
}
